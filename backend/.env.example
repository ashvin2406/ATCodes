# ============================================================
# ATCodes Platform — Production Environment Configuration Template
# Copy this file to .env and configure with your real values.
# NEVER commit real .env files with credentials to Git!
# ============================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Atlas Production Connection URI
# Obtain from MongoDB Atlas: Database -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atcodes?retryWrites=true&w=majority

# JWT Secret Key (Must be at least 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_key_32_chars_or_more
JWT_EXPIRES_IN=7d

# Session Cookie Secret & Domain Configuration
COOKIE_SECRET=replace_with_a_secure_cookie_session_secret_key_string
COOKIE_DOMAIN=atcodes.in
COOKIE_SAME_SITE=lax

# Frontend Production URLs and CORS Configuration
FRONTEND_URL=https://atcodes.in
CORS_ORIGINS=https://atcodes.in,https://www.atcodes.in,http://localhost:5000

# Initial Platform Seed Credentials (optional for npm run seed:content)
SEED_TEACHER_NAME=Prof. Alex Turner
SEED_TEACHER_EMAIL=teacher@atcodes.internal
SEED_TEACHER_PASSWORD=ATCodesTeacher2026!
SEED_TEACHER_MOBILE=+91 98765 00001
